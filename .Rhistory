# Load necessary packages
library(igraph)
library(sparsesvd)
library(Rphylopars)
library(ape)        # For phylogenetic tree manipulation
library(Matrix)     # For sparse matrix operations
library(tidyverse)
library(caret)  # For confusionMatrix
tme <-  theme(axis.text = element_text(size = 10, color = "black"),
axis.title = element_text(size = 12, face = "bold"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank())
theme_set(theme_bw())
setwd("~/Google Drive/My Drive/חשב מסלול מחדש/Shai/Shir")
network_data <- read.csv('rumen_mln.csv', stringsAsFactors = FALSE)
# Extract data for layer FarmA and FarmB
FarmA_data <- subset(network_data, layer == 'IT1')
FarmB_data <- subset(network_data, layer == 'IT2')
species_FarmA <- unique(c(FarmA_data$node_from, FarmA_data$node_to))
species_FarmB <- unique(c(FarmB_data$node_from, FarmB_data$node_to))
# Get the list of unique species in FarmA and FarmB
species_FarmA <- unique(c(FarmA_data$node_from, FarmA_data$node_to))
species_FarmB <- unique(c(FarmB_data$node_from, FarmB_data$node_to))
length(species_FarmA)
length(species_FarmB)
# Some measures of species similarity and overlap
intersect(species_FarmA, species_FarmB)
union(species_FarmA, species_FarmB)
length(intersect(species_FarmA, species_FarmB))/length(union(species_FarmA, species_FarmB)) # Jaccard
# Combine species lists to get all species involved
species_all <- union(species_FarmA, species_FarmB)
length(species_all)
# Create an edge list for FarmA
FarmA_edges <- FarmA_data %>% select(-layer, from=node_from, to=node_to, weight)
# Create an igraph object for FarmA
FarmA_graph <- graph_from_data_frame(FarmA_edges, directed = FALSE)
# Create an adjacency matrix for FarmA
FarmA_adj <- as_adjacency_matrix(FarmA_graph, attr = 'weight', sparse = TRUE)
FarmA_adj <- as(FarmA_adj, 'dgCMatrix')  # Ensure it's a sparse matrix
dim(FarmA_adj)
isSymmetric(FarmA_adj)
# Perform SVD on the FarmA adjacency matrix
SVD_res <- sparsesvd(FarmA_adj, rank = 0)  # Compute all ranks
# Determine the number of ranks to keep (e.g., explain 75% of variance)
cumulative_variance <- cumsum(SVD_res$d) / sum(SVD_res$d)
rank_cutoff <- which.max(cumulative_variance >= 0.3)
ncol(SVD_res$u) # Number of ranks
# Keep only the necessary ranks
(k <- rank_cutoff)
# Plot
y_k <- cumulative_variance[k] # Calculate the intersection point
ggplot(data=tibble(rank=1:length(cumulative_variance), cumsum=cumulative_variance), aes(x=rank, y=cumsum)) +
geom_point(color='salmon') +
geom_line(color='salmon') +
annotate("segment", x = k, xend = k, y = 0, yend = y_k, linetype="dashed") +  # Vertical line only to scatter point
annotate("segment", x = 0, xend = k, y = y_k, yend = y_k, linetype="dashed")
# Extract the singular values and vectors up to the selected rank
U <- SVD_res$u[, 1:k]
D <- diag(SVD_res$d[1:k])
V <- SVD_res$v[, 1:k]
# Prepare the trait data for species in FarmA
traits_FarmA <- data.frame(
species = species_FarmA,
U,
stringsAsFactors = FALSE
)
colnames(traits_FarmA)[-1] <- paste0('LV', 1:k)
# Perform phylogenetic imputation for species not in FarmA (species_to_impute)
species_to_impute <- setdiff(species_FarmB, species_FarmA)
# Combine trait data with species to impute
traits_all <- data.frame(
species = species_all,
stringsAsFactors = FALSE
)
traits_all <- merge(traits_all, traits_FarmA, by = 'species', all.x = TRUE)
# Prepare the data frame for phylopars
rownames(traits_all) <- traits_all$species
# Read the phylogenetic tree (assuming it's in Newick format)
phylo_tree <- readRDS("fitted_asvs_phylo_tree.rds")
phylo_species <- phylo_tree$tree$tip.label
common_species <- intersect(rownames(traits_all), phylo_species)
all(common_species %in% rownames(traits_all)) # Should be TRUE
phylo_tree <- keep.tip(phylo_tree$tree, common_species)
# Perform phylogenetic imputation
imputed_traits <- phylopars(
trait_data = traits_all,
tree = phylo_tree,
pheno_error = FALSE,
phylo_correlated = TRUE,
pheno_correlated = TRUE
)
imputed_traits_df <- as.data.frame(imputed_traits$anc_recon)
# Save the imputed traits as a CSV file
write.csv(imputed_traits_df, file = "imputed_traits1.csv", row.names = FALSE)
# Extract the imputed latent traits
latent_traits_imputed <- imputed_traits$anc_recon[common_species, ]
# Check that the latent_traits_imputed contains the original trait data in a correct manner
all(latent_traits_imputed[species_FarmA,]==as.matrix(traits_FarmA[,2:ncol(traits_FarmA)])) # Should be TRUE
