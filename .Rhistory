# Function to get all possible subsets of an array
get_subsets <- function(array) {
# Get the length of the array
n <- length(array)
# List to store all subsets
subsets <- list()
# Loop to generate combinations for each possible size
for (k in 2:n) {
# Generate combinations of size k
current_combinations <- combn(array, k, simplify = FALSE)
# Append to the list of subsets
subsets <- c(subsets, current_combinations)
}
return(subsets)
}
n_layers <- 7
y_k <- c(0.3, 0.5)
output_path <- "./HPC_configuration.sh"
line_list <- c()
for (l_train in 1:n_layers) {
for (l_test in 1:n_layers) {
for (current_yk in y_k) {
if (l_train != l_test) {
command <- paste("qsub run_embedding_lp.sh", l_train, l_test, current_yk)
line_list <- c(line_list, command)
}
}
}
}
# save the list of commands to a bash file
writeLines(line_list, output_path)
