fit <- lm(Observed ~ Predicted, data = df_plot)
summary(fit)
alpha <- coef(fit)[1]          # Intercept
beta  <- coef(fit)[2]          # Coefficient for predicted_values
# New SVD-based predictions after fitting
df_plot$predicted_values_rescaled <- alpha + beta * df_plot$predicted_values
df_plot
predicted_values_rescaled
alpha + beta * df_plot$predicted_values
df_plot$predicted_values
