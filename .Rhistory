cat("RMSE =", rmse, "\n")
# Correlation
cor(df_plot$Observed, df_plot$predicted_values_rescaled)
library(tidyverse)
# Function to get all possible subsets of an array
get_subsets <- function(array) {
# Get the length of the array
n <- length(array)
# List to store all subsets
subsets <- list()
# Loop to generate combinations for each possible size
for (k in 2:n) {
# Generate combinations of size k
current_combinations <- combn(array, k, simplify = FALSE)
# Append to the list of subsets
subsets <- c(subsets, current_combinations)
}
return(subsets)
}
